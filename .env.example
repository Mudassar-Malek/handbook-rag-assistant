# Copy to `.env` and edit to switch embedding providers.
# The pipeline defaults to a fully local model, so .env is optional.

# local | openai
EMBEDDING_PROVIDER=local

# Used when EMBEDDING_PROVIDER=local (downloaded once, then runs offline).
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Used when EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Phase 2 (retrieval) settings. All optional; sensible defaults shown.
# ---------------------------------------------------------------------------
# CHROMA_PATH=chroma_db
# COLLECTION_NAME=employee_handbook_2026

# Candidate pool sizes and final result count.
# VECTOR_N=20          # vector search top-N
# BM25_N=20            # BM25 search top-N
# FETCH_K=20           # fused candidates sent to the reranker
# TOP_K=5              # final results returned

# RRF_K=60             # Reciprocal Rank Fusion constant

# Cross-encoder reranker (set USE_RERANKER=false to skip the heavy model).
# USE_RERANKER=true
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Document-specific post-processing.
# USE_EXPANSION=true   # pull in sections referenced in-text ("see Section 5.11")
# USE_STITCHING=true   # fetch sibling parts of split sections (5.13, 10.11, 10.13)

# ---------------------------------------------------------------------------
# Phase 3 (multi-agent system) settings. All optional; defaults shown.
# ---------------------------------------------------------------------------
# Provider for the agents:
#   anthropic -> needs ANTHROPIC_API_KEY (set below)
#   openai    -> needs OPENAI_API_KEY (set above)
#   ollama    -> local LLM, NO API key (just run `ollama serve` + pull a model)
#   fake      -> deterministic offline model, no key (used by tests/demos)
LLM_PROVIDER=anthropic

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# OPENAI_MODEL=gpt-4o-mini

# --- Local LLM via Ollama (set LLM_PROVIDER=ollama) ---
# Install Ollama (https://ollama.com), then: `ollama pull llama3.1`
# Use a model that supports structured outputs/tools (llama3.1, qwen2.5, mistral-nemo).
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# TEMPERATURE=0          # keep at 0: HR facts must not drift
# MAX_RETRIES=2          # grader -> rewriter retries before honest fallback
# MAX_CONTEXT_CHUNKS=10  # excerpts handed to the answer node
# CHECKPOINT_DB=agent_checkpoints.sqlite   # per-thread memory store

# ---------------------------------------------------------------------------
# Phase 4 (observability) settings. Leave the keys unset to run with tracing
# disabled (the app logs one warning and works normally).
# ---------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Defaults to Langfuse Cloud; point at your own host when self-hosting.
# LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Phase 5 (evaluation) settings. The RAGAS judge reuses the same LLM_PROVIDER
# and API key as the agents above. With NO key set, the LLM-based RAGAS metrics
# (faithfulness / answer_relevancy / answer_correctness / context_precision /
# context_recall) are skipped and the LLM-free section_hit_rate still runs.
# ---------------------------------------------------------------------------
# The judge uses local HF embeddings (all-MiniLM-L6-v2) so RAGAS never makes
# paid embedding calls, regardless of provider.
# REGRESSION_THRESHOLD=0.05   # `run --check` fails on a >5% aggregate drop
